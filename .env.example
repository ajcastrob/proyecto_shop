# Copia este archivo como .env y rellena los valores.
# .env esta en .gitignore: nunca se commitea.

# Firma de cookies y sesiones. Obligatoria.
# Genera una con:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=

# True en local, False en produccion.
DEBUG=True

# Dominios permitidos, separados por coma.
ALLOWED_HOSTS=127.0.0.1,localhost

# Si no se define, se usa SQLite local (db.sqlite3).
# En produccion: postgres://usuario:password@dpg-xxxxxxx/nombre_db
DATABASE_URL=
